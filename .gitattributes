# --- Handoff packages ------------------------------------------------
# deliverables/ holds dated client packages, which are copies of the
# same client media. Same reasoning as assets/.
deliverables/**/*.png  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.PNG  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.JPG  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
# webp was missing here while assets/**/*.webp had it, so 519 derivative
# images (50 MB) in the two handoff packages would have gone into Git as raw
# blobs. Same media, same reasoning, same rule.
deliverables/**/*.webp filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.WEBP filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.heic filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.HEIC filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.tif  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.tiff filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.psd  filter=lfs diff=lfs merge=lfs -text
deliverables/**/*.zip  filter=lfs diff=lfs merge=lfs -text

# --- Brand system ----------------------------------------------------
# brand/ is the official global brand source of truth. The guidelines
# PDF and the logo raster are binaries and belong in LFS for the same
# reason the client photographs do — Git would otherwise keep a full
# copy of every revision forever, on every clone.
#
# Deliberately NOT listed here: brand.json and README.md. They are the
# part a human reviews, and a brand change must show up as a readable
# diff ("hot pink moved from #F20A88 to ...") rather than as an opaque
# LFS pointer swap. The `* text=auto eol=lf` rule at the top of this
# file already covers them.
#
# Also not listed: *.svg. A vector logo is XML, it is small, and its
# diff is worth reading. If a genuinely large SVG ever lands here,
# revisit that — do not pre-emptively hide it in LFS.
brand/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
brand/**/*.png  filter=lfs diff=lfs merge=lfs -text
brand/**/*.PNG  filter=lfs diff=lfs merge=lfs -text
brand/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
brand/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
brand/**/*.ai   filter=lfs diff=lfs merge=lfs -text
brand/**/*.eps  filter=lfs diff=lfs merge=lfs -text
brand/**/*.psd  filter=lfs diff=lfs merge=lfs -text
brand/**/*.otf  filter=lfs diff=lfs merge=lfs -text
brand/**/*.ttf  filter=lfs diff=lfs merge=lfs -text
brand/**/*.woff  filter=lfs diff=lfs merge=lfs -text
brand/**/*.woff2 filter=lfs diff=lfs merge=lfs -text

# --- Motion compositions ---------------------------------------------
# motion/*/assets holds copies of the same client product images the
# compositions are built from. Rendered video is gitignored; these are
# the SOURCE stills, and they are client media like everything above.
# Without these lines 27 files — 60 MB — went in as raw blobs.
motion/**/*.png  filter=lfs diff=lfs merge=lfs -text
motion/**/*.PNG  filter=lfs diff=lfs merge=lfs -text
motion/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
motion/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
motion/**/*.webp filter=lfs diff=lfs merge=lfs -text
