# ---------------------------------------------------------------
# Git LFS — client media
#
# Git stores a full copy of every version of every file it tracks, so a
# few dozen megabytes of client photographs would live in the history
# forever, on every clone. Git LFS keeps a small text pointer in Git and
# the actual bytes on the LFS server, so history stays small and the
# files stay byte-identical.
#
# Patterns are case-sensitive, which is why .HEIC and .heic are both
# listed. The client's iPhone writes uppercase.
#
# ORDER MATTERS. The last matching line wins for a given attribute, so
# the broad `* text=auto` rule goes FIRST and the per-format `-text`
# rules below override it. Flipping that order would let Git apply
# line-ending conversion to binary media.
# ---------------------------------------------------------------

# --- Line endings ----------------------------------------------------
# Text files normalize to LF in the repo regardless of platform.
* text=auto eol=lf
*.md   text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf

# --- Client media under assets/ ------------------------------------
assets/**/*.heic filter=lfs diff=lfs merge=lfs -text
assets/**/*.HEIC filter=lfs diff=lfs merge=lfs -text
assets/**/*.heif filter=lfs diff=lfs merge=lfs -text
assets/**/*.HEIF filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
assets/**/*.JPG  filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.JPEG filter=lfs diff=lfs merge=lfs -text
assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
assets/**/*.PNG  filter=lfs diff=lfs merge=lfs -text
assets/**/*.tif  filter=lfs diff=lfs merge=lfs -text
assets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.gif  filter=lfs diff=lfs merge=lfs -text
assets/**/*.bmp  filter=lfs diff=lfs merge=lfs -text
assets/**/*.psd  filter=lfs diff=lfs merge=lfs -text
assets/**/*.ai   filter=lfs diff=lfs merge=lfs -text
assets/**/*.eps  filter=lfs diff=lfs merge=lfs -text
assets/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
assets/**/*.dng  filter=lfs diff=lfs merge=lfs -text
assets/**/*.raw  filter=lfs diff=lfs merge=lfs -text
assets/**/*.cr2  filter=lfs diff=lfs merge=lfs -text
assets/**/*.nef  filter=lfs diff=lfs merge=lfs -text

# Video under assets/ is gitignored by default (see .gitignore). These
# lines exist so that if client SOURCE footage is ever added on purpose
# with `git add -f`, it goes through LFS rather than into Git as a raw
# blob. They do nothing on their own.
assets/**/*.mov  filter=lfs diff=lfs merge=lfs -text
assets/**/*.MOV  filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp4  filter=lfs diff=lfs merge=lfs -text
assets/**/*.MP4  filter=lfs diff=lfs merge=lfs -text

