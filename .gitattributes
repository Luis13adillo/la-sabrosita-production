menus/**/*.PNG  filter=lfs diff=lfs merge=lfs -text
menus/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
menus/**/*.JPG  filter=lfs diff=lfs merge=lfs -text
menus/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
